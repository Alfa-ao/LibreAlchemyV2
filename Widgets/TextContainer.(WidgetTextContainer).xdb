<?xml version="1.0" encoding="UTF-8"?>
<WidgetTextContainer>
	<Name>TextContainer</Name>
	<formatFileRef href="../Texts/TextContainerFormat.txt" />
	<defaultTag>text</defaultTag>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</Y>
	</Placement>
	<border href="Border.(WidgetPanel).xdb" />
	<TransparentInput>true</TransparentInput>
	<PickChildrenOnly>true</PickChildrenOnly>
</WidgetTextContainer>