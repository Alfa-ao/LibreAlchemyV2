<?xml version="1.0" encoding="UTF-8"?>
<WidgetButton>
    <Name>DragTopRight</Name>
    <Placement>
        <X>
            <Align>WIDGET_ALIGN_HIGH</Align>
            <HighPos>4</HighPos>
            <Pos>4</Pos>
            <Size>16</Size>
        </X>
        <Y>
            <Align>WIDGET_ALIGN_LOW</Align>
            <HighPos>5</HighPos>
            <Pos>5</Pos>
            <Size>16</Size>
        </Y>
    </Placement>
    <IgnoreDblClick>false</IgnoreDblClick>
    <reactionOnPointing>bottom_right_over</reactionOnPointing>
    <Variants>
        <Item>
            <LayerHighlight href="../../Textures/DragResize/Highlight.(WidgetLayerSimpleTexture).xdb"/>
            <StateNormal>
                <LayerMain href="../../Textures/DragResize/Normal.(WidgetLayerSimpleTexture).xdb"/>
            </StateNormal>
            <StatePushed>
                <LayerMain href="../../Textures/DragResize/Pushed.(WidgetLayerSimpleTexture).xdb"/>
            </StatePushed>
            <!-- <Reaction>bottom_right_pressed</Reaction>
            <ReactionRightClick>bottom_right_rmb_pressed</ReactionRightClick>
            <reactionDblClick>bottom_right_dbl_pressed</reactionDblClick> -->
            <ReactionOnUp>false</ReactionOnUp>
        </Item>
    </Variants>
</WidgetButton>