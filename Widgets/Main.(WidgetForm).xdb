<?xml version="1.0" encoding="UTF-8"?>
<WidgetForm>
	<Name>LibreAlchemyV2</Name>
	<Priority>10000</Priority>
	<Children>
		<Item href="Panel.(WidgetPanel).xdb" />
	</Children>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</Y>
	</Placement>
	
	<Visible>false</Visible>
	<!-- 
	<Visible>true</Visible> (Видимость)
	Тип: boolean (по умолчанию true).
	Значение: Отвечает за то, отображается ли виджет на экране. 
	Важно: Если виджет не виден (false), он становится полностью недоступен не только для глаз, 
		но и для всех реакций (событий мыши и клавиатуры).
	 -->
	
	<Enabled>true</Enabled>
	<!-- 
	<Enabled>true</Enabled> (Доступность / Активность)
    Тип: boolean (по умолчанию true).
    Значение: Отвечает за то, доступен ли виджет (и все его дочерние виджеты) для обработки реакций (кликов, наведений и т.д.).
    Визуал: Если установить в false, виджет обычно визуально "засеривается" (становится неактивным/полупрозрачным), 
		но при этом может оставаться видимым на экране (если Visible = true).
	 -->
	
	<TransparentInput>false</TransparentInput>
	<!-- 
	<TransparentInput>false</TransparentInput> (Прозрачность для ввода)
    Тип: boolean (по умолчанию false).
    TransparentInput = false
		Мышь не стопорится на самом виджете. Событие ввода проходит сквозь него к его дочерним элементам (children). 
		Сам виджет не перехватывает клик.
	TransparentInput = true
		Мышь не проходит дальше к дочерним элементам. 
		Виджет перехватывает ввод на себя, блокируя возможность кликнуть по его детям.
	 -->
	
	<PickChildrenOnly>true</PickChildrenOnly>
	<!-- 
	<PickChildrenOnly>false</PickChildrenOnly> (Перехватывать только дочерние элементы)
    Тип: boolean (по умолчанию false).
    Значение: Указывает системе обрабатывать реакции мышки только для дочерних виджетов (Children), полностью игнорируя сам родительский виджет.
    Как работает: Если true, то клик по пустому месту (фону/границам) самого виджета не вызовет реакцию. 
		Реакция сработает только в том случае, если курсор наведен непосредственно на один из его дочерних элементов (например, на текст),
		у которых false.
	 -->
</WidgetForm>