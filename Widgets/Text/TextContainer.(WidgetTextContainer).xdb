<?xml version="1.0" encoding="UTF-8"?>
<WidgetTextContainer>
	<Name>TextContainer</Name>
	<Priority>0</Priority>
	<formatFileRef href="ContainerFormat.txt" />
	<defaultTag>text</defaultTag>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Sizing>WIDGET_SIZING_DEFAULT</Sizing>
            <Size>533</Size>
			<Pos>15</Pos>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing><!-- Авторесайзинг по Y -->
			<Pos>15</Pos>
		</Y>
	</Placement>
	<clipContent>false</clipContent>
	
	<widgetsArrangement>WIDGETS_ARRANGEMENT_T2B</widgetsArrangement>
	
	<elementsInterval>0</elementsInterval>
	
	<TransparentInput>true</TransparentInput>
	<PickChildrenOnly>true</PickChildrenOnly>
	<Visible>true</Visible>
	<Enabled>true</Enabled>
</WidgetTextContainer>