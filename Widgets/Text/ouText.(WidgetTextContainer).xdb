<?xml version="1.0" encoding="UTF-8"?>
<WidgetTextContainer>
	<Name>ouText</Name>
	<Priority>0</Priority>
	<formatFileRef href="ContainerFormat.txt" />
	<defaultTag>text</defaultTag>
	<Placement>
		<X>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Sizing>WIDGET_SIZING_DEFAULT</Sizing>
            <Size>533</Size>
			<Pos>15</Pos>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_LOW</Align>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing><!-- Авторесайзинг по Y -->
			<Pos>15</Pos>
		</Y>
	</Placement>
	
	<!-- Отключаем обрезку, чтобы текст не скрылся при ресайзинге -->
	<clipContent>false</clipContent>
	
	<widgetsArrangement>WIDGETS_ARRANGEMENT_T2B</widgetsArrangement>
	<!-- 
	<widgetsArrangement>WIDGETS_ARRANGEMENT_T2B</widgetsArrangement>
	WidgetsArrangement - это enum, указывающий направление или порядок расположения элементов 
		в различных свойствах скроллируемых контейнерах и т.п. виджетах.
	Значения:
    	WIDGETS_ARRANGEMENT_T2B - сверху вниз
    	WIDGETS_ARRANGEMENT_L2R - слева направо
    	WIDGETS_ARRANGEMENT_B2T - снизу вверх
    	WIDGETS_ARRANGEMENT_R2L - справа налево 
	-->
	
	<elementsInterval>0</elementsInterval>
	
	<TransparentInput>true</TransparentInput>
	<PickChildrenOnly>true</PickChildrenOnly>
	<Visible>true</Visible>
	<Enabled>true</Enabled>
</WidgetTextContainer>